<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Traductor de Señas IA</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --secondary: #8b5cf6;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --bg-dark: #0f172a;
            --bg-card: #1e293b;
            --bg-elevated: #334155;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --border: #334155;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            color: var(--text-primary);
            overflow-x: hidden;
        }

        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            top: -250px;
            right: -250px;
            animation: float 20s ease-in-out infinite;
        }

        .bg-animation::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            bottom: -200px;
            left: -200px;
            animation: float 15s ease-in-out infinite reverse;
        }

        @keyframes float {

            0%,
            100% {
                transform: translate(0, 0) rotate(0deg);
            }

            33% {
                transform: translate(30px, -50px) rotate(120deg);
            }

            66% {
                transform: translate(-20px, 20px) rotate(240deg);
            }
        }

        /* Container */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        /* Header */
        header {
            text-align: center;
            margin-bottom: 3rem;
            animation: slideDown 0.6s ease-out;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h1 {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            letter-spacing: -1px;
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 1.1rem;
            font-weight: 400;
        }

        /* Main Grid */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 2rem;
            animation: fadeIn 0.8s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Video Card */
        .video-card {
            background: var(--bg-card);
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }

        .video-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
        }

        .video-container {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            background: #000;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        #video-feed {
            width: 100%;
            height: auto;
            display: block;
        }

        .video-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .current-letter {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .letter-display {
            font-size: 3rem;
            font-weight: 700;
            color: var(--success);
            text-shadow: 0 0 20px rgba(16, 185, 129, 0.5);
            animation: pulse 1.5s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }
        }

        .confidence-badge {
            background: rgba(16, 185, 129, 0.2);
            border: 2px solid var(--success);
            padding: 0.5rem 1rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .confidence-low {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--danger);
            color: var(--danger);
        }

        /* Sidebar */
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .card {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .card-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .icon-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
        }

        .icon-success {
            background: linear-gradient(135deg, var(--success), #059669);
            color: white;
        }

        .card-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .display-text {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--text-primary);
            min-height: 2rem;
            word-break: break-word;
            line-height: 1.4;
        }

        /* Sign Animation Card */
        .sign-animation-card {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border);
            text-align: center;
            min-height: 300px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .sign-display {
            font-size: 150px;
            margin: 1rem 0;
            opacity: 0;
            transform: scale(0.8);
            transition: all 0.3s ease;
        }

        .sign-display.active {
            opacity: 1;
            transform: scale(1);
            animation: signPulse 2s ease-in-out infinite;
        }

        @keyframes signPulse {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }
        }

        .sign-label {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
            margin-top: 1rem;
        }

        /* Progress Bar */
        .progress-container {
            width: 100%;
            height: 8px;
            background: var(--bg-elevated);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 1rem;
            display: none;
        }

        .progress-container.active {
            display: block;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--warning), var(--success));
            transition: width 0.2s ease;
            border-radius: 10px;
        }

        /* Letter Pills */
        .letters-container {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
            min-height: 50px;
        }

        .letter-pill {
            background: var(--bg-elevated);
            padding: 0.5rem 1rem;
            border-radius: 10px;
            font-weight: 600;
            color: var(--primary);
            border: 2px solid var(--primary);
            animation: popIn 0.3s ease-out;
        }

        @keyframes popIn {
            0% {
                opacity: 0;
                transform: scale(0.8);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Autocomplete Suggestions */
        .suggestions-container {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
        }

        .suggestion-chip {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary);
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .suggestion-chip:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
        }

        /* Stable Indicator */
        .stable-indicator {
            margin-top: 1rem;
            padding: 0.75rem;
            background: rgba(245, 158, 11, 0.1);
            border-left: 3px solid var(--warning);
            border-radius: 8px;
            font-size: 0.9rem;
            color: var(--warning);
            display: none;
        }

        .stable-indicator.active {
            display: block;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-10px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Status Indicator */
        .status-indicator {
            transform: translateX(-50%);
            background: var(--primary);
            color: white;
            padding: 0.3rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        @keyframes fadeInSlide {
            from {
                opacity: 0;
                transform: translateY(-50%) translateX(20px);
            }

            to {
                opacity: 1;
                transform: translateY(-50%) translateX(0);
            }
        }

        /* Toggle Button */
        .learning-toggle {
            position: fixed;
            bottom: 2rem;
            left: 2rem;
            z-index: 1000;
        }

        .toggle-btn {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 1rem 1.5rem;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
            transition: all 0.3s ease;
        }

        .toggle-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.6);
        }

        .toggle-btn.active {
            background: linear-gradient(135deg, var(--success), #059669);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .main-grid {
                grid-template-columns: 1fr;
            }

            h1 {
                font-size: 2rem;
            }

            .sign-display {
                font-size: 100px;
            }

            .ar-overlay {
                width: 150px;
                height: 150px;
            }
        }
    </style>
</head>

<body>
    <div class="bg-animation"></div>

    <div class="container">
        <header>
            <h1>🤟 Traductor de Señas IA</h1>
            <p class="subtitle">Reconocimiento en tiempo real con ResNet18</p>
        </header>

        <div class="main-grid">
            <!-- Video Section -->
            <div class="video-card">
                <div class="video-container">
                    <img id="video-feed" src="{{ url_for('video_feed') }}" alt="Video Feed">
                    <div class="video-overlay">
                        <div class="current-letter">
                            <div class="letter-display" id="current-letter">-</div>
                        </div>
                        <div class="confidence-badge" id="confidence-badge">0%</div>
                    </div>
                    <!-- AR Overlay -->
                    <div class="ar-overlay" id="ar-overlay">
                        <div class="ar-label" id="ar-label">Guía</div>
                        <img id="ar-image" src="" alt="Sign Reference">
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sign Animation -->
                <div class="sign-animation-card">
                    <div class="card-header">
                        <div class="card-icon icon-primary">
                            <i class="fas fa-hand-sparkles"></i>
                        </div>
                        <h3 class="card-title">Seña LSC Detectada</h3>
                    </div>
                    <div class="sign-display" id="sign-display">🤟</div>
                    <div class="sign-label" id="sign-label">-</div>
                    <div class="progress-container" id="progress-container">
                        <div class="progress-bar" id="progress-bar"></div>
                    </div>
                </div>

                <!-- Current Word -->
                <div class="card">
                    <div class="card-header">
                        <div class="card-icon icon-primary">
                            <i class="fas fa-hand-point-up"></i>
                        </div>
                        <h3 class="card-title">Palabra Actual</h3>
                    </div>
                    <div class="display-text" id="palabra-actual">-</div>
                    <div class="letters-container" id="letters-container"></div>

                    <!-- Autocomplete Suggestions -->
                    <div class="suggestions-container" id="suggestions-container">
                        <!-- Suggestions will be injected here -->
                    </div>

                    <div class="stable-indicator" id="stable-indicator">
                        <i class="fas fa-hourglass-half"></i> Confirmando en: <span id="stable-timer">-</span>s
                    </div>
                </div>

                <!-- Full Phrase -->
                <div class="card">
                    <div class="card-header">
                        <div class="card-icon icon-success">
                            <i class="fas fa-comments"></i>
                        </div>
                        <h3 class="card-title">Frase Completa</h3>
                    </div>
                    <div class="display-text" id="frase">-</div>
                    <button class="clear-btn" onclick="borrarFrase()">
                        <i class="fas fa-trash-alt"></i> Borrar Frase
                    </button>
                </div>

                <!-- Status -->
                <div class="card">
                    <div class="card-header">
                        <div class="status-indicator">
                            <div class="status-dot"></div>
                            <span>Sistema Activo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Learning Mode Toggle -->
    <div class="learning-toggle">
        <button class="toggle-btn" id="learning-toggle" onclick="toggleLearningMode()">
            <i class="fas fa-graduation-cap"></i>
            <span id="toggle-text">Activar Modo Aprendizaje</span>
        </button>
    </div>

    <script>
        // Learning mode state
        let learningMode = false;
        // Mapeo de letras a emojis de manos
        const signEmojis = {
            'A': '✊', 'B': '🖐️', 'C': '🤏', 'D': '👌', 'E': '✊',
            'F': '👌', 'H': '☝️', 'I': '🤙', 'K': '✌️', 'L': '🤘',
            'M': '✊', 'N': '✊', 'O': '👌', 'P': '👇', 'Q': '🤞',
            'R': '✌️', 'T': '✊', 'U': '✌️', 'V': '✌️', 'W': '🤟',
            'X': '☝️', 'Y': '🤙'
        };

        // Actualizar estado cada 200ms
        setInterval(async () => {
            try {
                const response = await fetch('/get_estado');
                const data = await response.json();

                // 1. Actualizar letra actual en video
                const letterEl = document.getElementById('current-letter');
                if (letterEl) letterEl.textContent = data.letra || '-';

                // 2. Actualizar animación de seña
                const signDisplay = document.getElementById('sign-display');
                const signLabel = document.getElementById('sign-label');
                if (signDisplay && signLabel) {
                    if (data.letra) {
                        signDisplay.textContent = signEmojis[data.letra] || '🤟';
                        signLabel.textContent = data.letra;
                        signDisplay.classList.add('active');
                    } else {
                        signDisplay.textContent = '🤟';
                        signLabel.textContent = '-';
                        signDisplay.classList.remove('active');
                    }
                }

                // Actualizar AR Overlay
                updateAROverlay(data.letra);

                // 3. Actualizar confianza
                const confEl = document.getElementById('confidence-badge');
                if (confEl) {
                    const confPercent = Math.round(data.confianza * 100);
                    confEl.textContent = confPercent + '%';
                    if (data.confianza >= 0.90) {
                        confEl.className = 'confidence-badge';
                    } else {
                        confEl.className = 'confidence-badge confidence-low';
                    }
                }

                // 4. Letra estable y progreso
                const stableIndicator = document.getElementById('stable-indicator');
                const stableTimer = document.getElementById('stable-timer');
                const progressContainer = document.getElementById('progress-container');
                const progressBar = document.getElementById('progress-bar');

                if (stableIndicator && stableTimer && progressContainer && progressBar) {
                    if (data.letra_estable && data.tiempo_restante !== undefined) {
                        stableIndicator.classList.add('active');
                        stableTimer.textContent = data.tiempo_restante.toFixed(1);

                        // Mostrar barra de progreso
                        progressContainer.classList.add('active');
                        const progress = ((2.5 - data.tiempo_restante) / 2.5) * 100;
                        progressBar.style.width = progress + '%';
                    } else {
                        stableIndicator.classList.remove('active');
                        progressContainer.classList.remove('active');
                        progressBar.style.width = '0%';
                    }
                }

                // 5. Palabra actual
                const palabraActualEl = document.getElementById('palabra-actual');
                if (palabraActualEl) palabraActualEl.textContent = data.palabra_actual || '-';

                // 6. Letras detectadas como pills
                const lettersContainer = document.getElementById('letters-container');
                if (lettersContainer) {
                    lettersContainer.innerHTML = '';
                    if (data.letras && data.letras.length > 0) {
                        data.letras.forEach(letra => {
                            const pill = document.createElement('div');
                            pill.className = 'letter-pill';
                            pill.textContent = letra;
                            lettersContainer.appendChild(pill);
                        });
                    }
                }

                // 7. Sugerencias de autocompletado
                const suggestionsContainer = document.getElementById('suggestions-container');
                if (suggestionsContainer) {
                    suggestionsContainer.innerHTML = '';
                    if (data.sugerencias && data.sugerencias.length > 0) {
                        data.sugerencias.forEach(word => {
                            const chip = document.createElement('div');
                            chip.className = 'suggestion-chip';
                            chip.textContent = word;
                            chip.onclick = () => completarPalabra(word);
                            suggestionsContainer.appendChild(chip);
                        });
                    }
                }

                // 8. Frase Completa
                const fraseEl = document.getElementById('frase');
                if (fraseEl) fraseEl.textContent = data.frase || '-';

            } catch (error) {
                console.error('Error actualizando estado:', error);
            }
        }, 200);

        async function completarPalabra(palabra) {
            try {
                const response = await fetch('/completar_palabra', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ palabra: palabra })
                });
                const data = await response.json();
                if (data.success) {
                    // Feedback visual
                    const suggestions = document.getElementById('suggestions-container');
                    if (suggestions) {
                        suggestions.style.opacity = '0.5';
                        setTimeout(() => suggestions.style.opacity = '1', 200);
                    }
                }
            } catch (error) {
                console.error('Error completando palabra:', error);
            }
        }

        async function borrarFrase() {
            try {
                const response = await fetch('/borrar_frase', { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    const fraseEl = document.getElementById('frase');
                    if (fraseEl) fraseEl.textContent = '-';
                }
            } catch (error) {
                console.error('Error borrando frase:', error);
            }
        }

        async function limpiar() {
            try {
                const response = await fetch('/limpiar', { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    // Animación de limpieza
                    document.querySelectorAll('.display-text').forEach(el => {
                        el.style.opacity = '0';
                        setTimeout(() => el.style.opacity = '1', 200);
                    });
                }
            } catch (error) {
                console.error('Error limpiando:', error);
            }
        }

        // Toggle Learning Mode
        function toggleLearningMode() {
            learningMode = !learningMode;
            const toggleBtn = document.getElementById('learning-toggle');
            const toggleText = document.getElementById('toggle-text');

            if (learningMode) {
                toggleBtn.classList.add('active');
                toggleText.textContent = 'Desactivar Modo Aprendizaje';
            } else {
                toggleBtn.classList.remove('active');
                toggleText.textContent = 'Activar Modo Aprendizaje';
                // Hide overlay
                const arOverlay = document.getElementById('ar-overlay');
                if (arOverlay) arOverlay.classList.remove('active');
            }
        }

        // Update AR Overlay
        function updateAROverlay(letra) {
            if (!learningMode || !letra) {
                const arOverlay = document.getElementById('ar-overlay');
                if (arOverlay) arOverlay.classList.remove('active');
                return;
            }

            const arOverlay = document.getElementById('ar-overlay');
            const arImage = document.getElementById('ar-image');
            const arLabel = document.getElementById('ar-label');

            if (arOverlay && arImage && arLabel) {
                // Try to load the reference image
                const imagePath = `/static/sign_references/${letra}.png`;
                arImage.src = imagePath;
                arLabel.textContent = `Seña: ${letra}`;
                arOverlay.classList.add('active');

                // Hide if image fails to load
                arImage.onerror = () => {
                    arOverlay.classList.remove('active');
                };
            }
        }

        // Atajos de teclado
        document.addEventListener('keydown', (e) => {
            if (e.key === 'l' || e.key === 'L') {
                toggleLearningMode();
            } else if (e.key === 'o' || e.key === 'O') {
                // finalizarPalabra(); // Esta función no estaba definida en el script anterior, quizás se borró. 
                // Si existe un endpoint para finalizar palabra manualmente, se debería llamar aquí.
                // Por ahora, completarPalabra maneja la finalización si se selecciona una sugerencia.
                // Si 'O' era para forzar guardar la palabra actual:
                // fetch('/completar_palabra', ... con la palabra actual?)
            } else if (e.key === 'c' || e.key === 'C') {
                limpiar();
            }
        });
    </script>
</body>

</html>